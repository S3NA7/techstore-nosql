# Copie para .env e ajuste se necessário. Valores abaixo = docker-compose.yml local.
# Use 127.0.0.1 (não "localhost"): no Windows, localhost resolve para IPv6 (::1) e o
# Docker Desktop aceita a conexão mas não a encaminha, causando timeouts no Redis e no Neo4j.

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB=techstore

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0

# Neo4j (nomes conforme o enunciado; para AuraDB use neo4j+s://<id>.databases.neo4j.io)
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=techstore123
NEO4J_DATABASE=neo4j

# Tempos de vida em segundos
SESSION_TTL_SECONDS=1800
CACHE_TTL_SECONDS=300
CART_TTL_SECONDS=604800
